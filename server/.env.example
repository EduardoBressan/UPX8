# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA commite o arquivo ".env" (ele contem a chave de API).

# Chave da API do Google Gemini (obtida em https://aistudio.google.com/apikey)
GEMINI_API_KEY=coloque_sua_chave_aqui

# Porta em que o backend vai rodar
PORT=3000

# Origem(ns) permitida(s) para CORS durante o desenvolvimento.
# Em desenvolvimento local com Expo, "*" e aceitavel; em producao, restrinja.
CORS_ORIGIN=*
